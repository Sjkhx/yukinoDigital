# ---- LLM API key（必填）----
# configs/assistant.yaml 里 llm.api_key_env 指向这个名字；管线从环境读取
# （兜底变量名 LLM_API_KEY），缺失会直接报错。
# DeepSeek key 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 阿里云百炼 DashScope API key（ASR 用，stt.backend=qwen3asr_flash 时必填）----
# 在 https://bailian.console.aliyun.com 申请
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 记忆 embedding API key（memory 积木用，qwen3.7-text-embedding）----
# configs/assistant.yaml 里 memory.embedder_api_key_env 指向；OpenAI 兼容 /v1/embeddings
MEMORY_EMBEDDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Hugging Face token（服务器上下载模型用，可选）----
# HF_TOKEN=

# ---- 可选：配置路径（默认 configs/assistant.yaml）----
# VOXEMW_CONFIG=configs/assistant.yaml
